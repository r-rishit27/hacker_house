# Copy to .env and fill in. Never commit .env.

# ── TigerGraph Savanna ───────────────────────────────────────────────────────
TG_HOST=https://tg-xxxxxxxx.i.tgcloud.io
TG_SECRET=your-savanna-secret
TG_GRAPH=GRAPH_GOA
# Savanna terminates both REST++ and GSQL on 443.
TG_RESTPP_PORT=443
TG_GSQL_PORT=443
TG_CHUNK_ROWS=120000

# ── OpenAI ───────────────────────────────────────────────────────────────────
# The backend refuses to start without all three. The two model ids have no
# defaults on purpose: a hard-coded model id is how an hour goes to a 404.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# 1536 -> 256 cuts the ClosedCase embedding write-back from ~130 MB to ~25 MB.
OPENAI_EMBEDDING_DIMENSIONS=256

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── managed by scripts/setup_mcp.py: tigergraph-mcp reads these ──────────────
TG_GRAPHNAME=GRAPH_GOA
TG_GS_PORT=443
TG_API_TOKEN=
