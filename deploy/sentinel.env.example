# The deployed backend's environment. Copy to /etc/sentinel/sentinel.env on
# the instance, fill it in, and lock it down:
#
#   sudo install -d -m 0750 -o root -g sentinel /etc/sentinel
#   sudo install -m 0640 -o root -g sentinel sentinel.env /etc/sentinel/sentinel.env
#
# systemd reads this file directly, so it is KEY=value and nothing else: no
# `export`, no `$OTHER_VAR` expansion, no inline `#` comments after a value.
#
# This is the whole configuration. The checkout on the server has no `.env` —
# pydantic-settings would read one from the repository root if it were there,
# and two sources of truth for a credential is how a rotated key keeps working
# on one path and not the other.

# ── TigerGraph Savanna ───────────────────────────────────────────────────────
TG_HOST=https://tg-xxxxxxxx.i.tgcloud.io
TG_SECRET=your-savanna-secret
TG_GRAPH=GRAPH_GOA
TG_RESTPP_PORT=443
TG_GSQL_PORT=443
# The workspace auto-stops when idle and takes about 45 seconds to wake. The
# repository retries the HTML "Starting workspace" page rather than reporting
# it as an error; four attempts covers a cold start.
TG_CONNECT_RETRIES=4
TG_QUERY_TIMEOUT_S=120

# ── OpenAI ───────────────────────────────────────────────────────────────────
# All three are required and the two model ids have no defaults on purpose: a
# hard-coded model id is how an hour goes to a 404. The service will not start
# without them, which is the intended behaviour — a process that starts and
# then fails every run is worse than one that refuses to start.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=256

# ── the console's origin ─────────────────────────────────────────────────────
# The Amplify branch URL, verbatim: scheme included, no trailing slash, no
# space after the comma. Every browser request from the console fails CORS
# until this matches exactly, and the failure looks like the API being down.
# Add the custom domain too once Amplify has one, comma-separated.
CORS_ORIGINS=https://main.dxxxxxxxxxxxxx.amplifyapp.com

# ── the process ──────────────────────────────────────────────────────────────
# Loopback only. nginx is the one thing on a public port.
API_HOST=127.0.0.1
API_PORT=8000

# ── budgets ──────────────────────────────────────────────────────────────────
# The defaults, written out so they are visible on the box rather than only in
# the source. Each one ends a run as `budget_exceeded` rather than silently.
MAX_TOOL_CALLS_PER_RUN=25
MAX_TOKENS_PER_RUN=120000
MAX_USD_PER_RUN=1.50
MAX_RUN_SECONDS=300
# Each concurrent investigation holds a graph connection slot and a model
# budget. Four is the measured point where the workspace still answers in
# under a second; raise it only after watching the graph's latency.
MAX_CONCURRENT_INVESTIGATIONS=4
