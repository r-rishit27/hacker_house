# Copy to .env.local for local development. `.env*.local` is gitignored; this
# file is the record of what the console needs.
#
# In production nothing reads this file: Amplify supplies the variable from
# App settings ▸ Environment variables, and Next inlines it into the client
# bundle at build time. See amplify.yml.

# Where the API is. No trailing slash.
#
# Locally: whatever port uvicorn is on.
# Deployed: the https origin of the EC2 box, e.g. https://api.example.com.
# It must be https — the console is served over https and a browser blocks an
# http call from an https page as mixed content before the request is sent.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
